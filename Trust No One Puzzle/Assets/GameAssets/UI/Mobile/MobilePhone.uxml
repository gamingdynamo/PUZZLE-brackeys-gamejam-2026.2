<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Theme/MobileTheme.uss" />
    <ui:VisualElement name="phone-root" class="phone-root hidden" picking-mode="Position">
        <ui:VisualElement name="phone-frame" class="phone-frame">
            <ui:VisualElement class="phone-notch" picking-mode="Ignore" />
            <ui:VisualElement class="phone-status" picking-mode="Ignore">
                <ui:Label name="clock" text="9:41" class="phone-clock" />
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Label name="carrier" text="LTE" class="phone-carrier" style="margin-right: 8px;" />
                    <ui:Label name="signal" text="▮▮▮▯  100%" class="phone-signal" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="phone-screen">
                <ui:VisualElement class="phone-header">
                    <ui:Button name="btn-close" text="‹" class="icon-btn" />
                    <ui:VisualElement class="avatar" picking-mode="Ignore">
                        <ui:Label text="?" class="avatar-letter" />
                    </ui:VisualElement>
                    <ui:VisualElement class="header-text" picking-mode="Ignore">
                        <ui:Label text="Unknown" class="phone-title" />
                        <ui:Label text="Mobile · SMS" class="phone-subtitle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="unread-dot" class="unread-dot" />
                    <ui:Button text="⋮" class="icon-btn" />
                </ui:VisualElement>
                <ui:ScrollView name="chat-scroll" class="chat-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="chat-list" class="chat-list" />
                </ui:ScrollView>
                <ui:VisualElement class="phone-footer">
                    <ui:VisualElement class="composer" picking-mode="Ignore">
                        <ui:Label text="Text message" class="composer-hint" />
                    </ui:VisualElement>
                    <ui:Button text="➤" class="send-btn" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="nav-bar">
                <ui:Button name="nav-back" text="◁" class="nav-icon" />
                <ui:Button name="nav-home" text="○" class="nav-icon" />
                <ui:Button name="nav-recents" text="□" class="nav-icon" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
